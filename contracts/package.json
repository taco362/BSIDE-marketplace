{
  "name": "b-side-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc --noEmit",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "mint:local": "hardhat run scripts/mint.ts --network localhost",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "setup:local": "npm run deploy:local && npm run seed:local"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^5.3.3",
    "ethers": "^6.17.0",
    "hardhat": "^3.22.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3"
  }
}
