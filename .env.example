# Next.js 서버 전용 환경 변수 예시
# 이 파일을 .env.local로 복사한 뒤 값을 채운다. .env.local은 git에 커밋하지 않는다.
# 비밀값에는 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (붙이면 브라우저 번들에 포함된다).

# 서버에서 컨트랙트를 조회할 RPC 주소
#   개발: http://127.0.0.1:8545
#   Sepolia 시연: https://ethereum-sepolia-rpc.publicnode.com
#   (Alchemy 무료 등급은 eth_getLogs가 10블록 제한이라 조회용으로 쓰지 않는다. 배포는 Hardhat keystore의 SEPOLIA_RPC_URL)
# API 키가 포함된 주소라면 비밀값으로 취급한다.
RPC_URL=

# Pinata 업로드용 JWT (Phase 2부터 사용)
PINATA_JWT=

# AI 보조 기능용 Google Gemini API 키 (D14, A2부터 사용). 서버 전용
# 비용이 들지 않도록 Google AI Studio에서 결제를 연결하지 않은 프로젝트의 키(무료 등급)를 쓴다.
GEMINI_API_KEY=
